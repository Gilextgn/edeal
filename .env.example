# Copiez ce fichier en .env.local et remplissez-le. Ne commitez jamais .env.local.

# Affichés par `npm run db:status` en local (API URL et Publishable key),
# ou dans le tableau de bord Supabase en production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (« Secret key » de `npm run db:status`). Utilisée uniquement par
# le serveur, pour bloquer les essais de mots de passe en série.
# Ne jamais la préfixer par NEXT_PUBLIC_ : elle ne doit pas atteindre le navigateur.
SUPABASE_SECRET_KEY=

# Indicatif ajouté aux numéros saisis sans indicatif (229 = Bénin).
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=229
